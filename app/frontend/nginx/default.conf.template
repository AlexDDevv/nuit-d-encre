server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Redirections en chemin relatif. Le conteneur écoute en clair sur 8080
    # derrière le proxy CapRover : laissé à lui-même, nginx reconstruirait un
    # Location absolu avec ce schéma et ce port internes, injoignables depuis
    # l'extérieur (http://nuitdencre.fr:8080/...).
    absolute_redirect off;

    # Ne pas annoncer la version de nginx dans les en-têtes et pages d'erreur.
    server_tokens off;

    # En-têtes de sécurité, hérités par toutes les locations (aucune ne
    # redéfinit add_header). `always` : posés aussi sur les réponses d'erreur.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Interdit l'affichage du site dans une iframe (clickjacking).
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
    # HTTPS imposé au navigateur pendant 180 jours (ignoré en HTTP). Sans
    # includeSubDomains : les sous-domaines CapRover restent hors du champ.
    add_header Strict-Transport-Security "max-age=15552000" always;
    # Politique de sécurité du contenu : le navigateur refuse toute source
    # absente de cette liste. Appliquée après une phase en Report-Only sans
    # aucune violation en prod (connexion Google et navigation comprises).
    # Toute nouvelle origine externe (script, iframe, API appelée par le
    # navigateur) doit être ajoutée ici, sinon elle sera bloquée.
    #   - images : couvertures externes (Open Library, Google Books) et
    #     Cloudinary, d'où https: ;
    #   - accounts.google.com/gsi : bouton et popup de connexion Google ;
    #   - style 'unsafe-inline' : attributs style de React et des animations.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    # IP réelle du client. Le nginx de CapRover ajoute l'IP du client en fin
    # de X-Forwarded-For ; tout ce qui précède vient du client et peut être
    # falsifié. realip parcourt l'en-tête depuis la droite en sautant les
    # proxys internes (réseaux privés Docker / overlay) : $remote_addr devient
    # la première IP non interne, celle du vrai client.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # API GraphQL — proxy même-origine vers le backend interne CapRover.
    # DNS Docker (127.0.0.11) + proxy_pass via variable => nginx re-résout
    # l'IP du backend à chaque requête. Le front survit ainsi aux redeploys
    # du backend (nouvelle IP overlay) sans redémarrage.
    # $request_uri conserve le préfixe /api (Apollo standalone répond sur tout
    # chemin) : indispensable avec une variable, car proxy_pass n'ajoute alors
    # pas l'URI d'origine automatiquement.
    location /api {
        resolver 127.0.0.11 valid=10s;
        set $backend "${BACKEND_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Réécrits (jamais ajoutés) : le back lit X-Real-IP pour le rate
        # limiting et ne doit voir aucune valeur fournie par le client.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # L'ancienne URL de la politique de confidentialité rendait le même
    # document que /terms-of-use ; la route a été supprimée du SPA. Redirection
    # permanente pour ne pas casser les liens déjà publiés ou indexés.
    location = /confidentialite {
        return 301 /terms-of-use;
    }

    # SPA — fallback history sur index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
