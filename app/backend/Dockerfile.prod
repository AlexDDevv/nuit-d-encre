# Contexte de build : archive produite par scripts/caprover-archive.sh
# (dossier de l'app + `_workspace/` avec le lockfile du monorepo).

# --- Build stage ---
FROM node:24-alpine3.21 AS builder
WORKDIR /repo
RUN corepack enable pnpm

# Dépendances figées par le lockfile (mêmes versions que la CI)
COPY _workspace/ ./
RUN pnpm install --frozen-lockfile --filter backend

# Sources + config de compilation
WORKDIR /repo/app/backend
COPY tsconfig.json ./
COPY src ./src
RUN pnpm build

# --- Runtime stage ---
FROM node:24-alpine3.21 AS runner
ENV NODE_ENV=production
WORKDIR /repo
RUN corepack enable pnpm

# Dépendances de production uniquement, toujours figées par le lockfile
COPY _workspace/ ./
RUN pnpm install --frozen-lockfile --prod --filter backend

# Artefacts compilés
WORKDIR /repo/app/backend
COPY --from=builder /repo/app/backend/dist ./dist

# Exécution non-root
USER node

EXPOSE 3310
CMD ["node", "dist/server.js"]
